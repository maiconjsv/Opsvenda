# Copie este arquivo para .env e ajuste os valores antes de rodar o instalador.

# Porta exposta no host para acessar o sistema (http://localhost:APP_PORT)
APP_PORT=5000

# Chave usada para assinar sessões/cookies - gere uma string aleatória única.
SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# Usuário administrador criado automaticamente na primeira execução.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
