# Copie este arquivo para .env e ajuste os valores.

# Porta exposta no host (docker compose): http://localhost:APP_PORT
APP_PORT=5000

# Obrigatória: chave usada para assinar sessões/cookies. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# Banco de dados. Sem isso, usa SQLite em instance/app.db (ok para
# desenvolvimento). Em produção use Postgres:
#   postgresql://usuario:senha@host:5432/opsvenda
# DATABASE_URL=

# Assinatura via Pix (Mercado Pago). Sem isso configurado, a página de
# assinatura mostra erro ao tentar gerar uma cobrança (o resto do sistema
# funciona normalmente, só a geração de Pix novo fica indisponível).
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-... (ou TEST-... para sandbox)
# MP_SANDBOX=false
