# Copie este arquivo para .env e ajuste os valores antes de rodar o instalador.

# Porta exposta no host para acessar o sistema (http://localhost:APP_PORT)
APP_PORT=5000

# Opcional: chave usada para assinar sessões/cookies. Se não definida, a
# aplicação gera e persiste uma chave aleatória automaticamente na primeira
# execução (em instance/secret_key.txt).
# SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# Não há mais usuário admin pré-configurado por variável de ambiente: no
# primeiro acesso, a aplicação abre uma tela de cadastro para criar a conta
# administradora pelo navegador.
