# Copie este arquivo para .env e ajuste os valores.

# Obrigatória: chave usada para assinar sessões/cookies. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# Desenvolvimento local: Postgres da sua máquina (veja o README).
# Em produção o docker-compose.yml monta a URL a partir de POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://opsvenda:opsvenda@localhost:5432/opsvenda

# Produção (docker compose): senha do Postgres do container opsvenda-db.
POSTGRES_PASSWORD=troque-esta-senha

# Assinatura via Pix (Mercado Pago). Sem isso configurado, a página de
# assinatura mostra erro ao tentar gerar uma cobrança (o resto do sistema
# funciona normalmente, só a geração de Pix novo fica indisponível).
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-... (ou TEST-... para sandbox)
# MP_SANDBOX=false
