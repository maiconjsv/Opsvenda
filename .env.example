# Copie este arquivo para .env e ajuste os valores antes de rodar o instalador.

# Porta exposta no host para acessar o sistema (http://localhost:APP_PORT)
APP_PORT=5000

# Opcional: chave usada para assinar sessões/cookies. Se não definida, a
# aplicação gera e persiste uma chave aleatória automaticamente na primeira
# execução (em instance/secret_key.txt).
# SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# Não há mais usuário admin pré-configurado por variável de ambiente: no
# primeiro acesso, a aplicação abre uma tela de cadastro para criar a conta
# administradora pelo navegador.

# Modo SaaS multi-tenant (usado no deploy da VM, ex: opsvenda.montiqtech.com.br):
# "0" (padrão) = modo single-tenant do app desktop, com a própria tela de
# login liberando a criação de uma conta só, pra sempre, quando não existe
# nenhum usuário ainda. "1" = libera o cadastro público (/auth/cadastro) pra
# qualquer empresa criar sua própria conta a qualquer momento, cada empresa
# só enxerga os próprios dados, e a cobrança de assinatura (abaixo) passa a
# valer.
# OPSVENDA_MULTI_TENANT=1

# Necessário em modo multi-tenant com mais de um worker/processo (Postgres
# em vez do SQLite local): postgresql://usuario:senha@host:5432/opsvenda
# DATABASE_URL=

# Assinatura via Pix (Mercado Pago) - só usado em modo multi-tenant. Mesma
# conta/token já usada pelo BookCase SaaS. Sem isso configurado, a página de
# assinatura mostra erro ao tentar gerar uma cobrança (o resto do sistema
# funciona normalmente, só a geração de Pix novo fica indisponível).
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-... (ou TEST-... para sandbox)
# MP_SANDBOX=false
